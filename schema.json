{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proiector fără frontiere — descriptor de widget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "entry",
    "permissions",
    "description",
    "i18n"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entry": {
      "type": "string",
      "pattern": "^widgets/[a-z0-9-]+/index\\.js$"
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "enum": [
          "none",
          "drawing",
          "storage",
          "download"
        ]
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "i18n": {
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "ro": {
          "type": "object",
          "required": [
            "name",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        },
        "en": {
          "type": "object",
          "required": [
            "name",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        },
        "fr": {
          "type": "object",
          "required": [
            "name",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        },
        "de": {
          "type": "object",
          "required": [
            "name",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        },
        "es": {
          "type": "object",
          "required": [
            "name",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        },
        "it": {
          "type": "object",
          "required": [
            "name",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        },
        "hu": {
          "type": "object",
          "required": [
            "name",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        },
        "pt": {
          "type": "object",
          "required": [
            "name",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        }
      }
    }
  }
}
